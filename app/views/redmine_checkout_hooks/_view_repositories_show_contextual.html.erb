<div class="repository-info">
  <% if repository_http %>
    <div id="smart_http">
      <a href="<%= ERB::Util.html_escape(repository_url) %>">Smart HTTP</a>
    </div>
  <% end %>
  <%= text_field_tag :checkout_cmd, repository_cmd, :readonly => true %>
  <div id="clipboard_button" title="<%= l(:label_copy_to_clipboard) %>"><%= image_tag 'paste.png', :plugin => 'redmine_scm' %></div>
</div>
<div style="clear: left"></div>

<%= javascript_tag do -%>
function copy_command() {
  var command = document.getElementById("checkout_cmd");
  command.select();
  document.execCommand("copy");
}

document.addEventListener("DOMContentLoaded", function(event) { 
  var command = document.getElementById("clipboard_button");
  command.onclick = copy_command
});

<% end %>
